# Copy this file to .env for local development (npm run dev).
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Generate good values with:  npm run secrets

# The password you type into the "Master login" form on the site.
ADMIN_PASSWORD=change-me

# A long random string used to sign the login cookie (at least 16 characters).
SESSION_SECRET=change-me-to-a-long-random-string

# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob
# store to the project. You do not set it by hand on Vercel.
#
# Only if you created a PUBLIC blob store (Private is recommended):
# BLOB_ACCESS=public
